[Unit]
Description=StreamClipper OS private YouTube worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=streamclipper
Group=streamclipper
WorkingDirectory=/opt/streamclipper-os/streamclipper_os
EnvironmentFile=-/etc/streamclipper-os.env
ExecStart=/opt/streamclipper-os/.venv/bin/python /opt/streamclipper-os/streamclipper_os/youtube_daemon.py --db /var/lib/streamclipper-os/state.sqlite3 --interval 30
Restart=on-failure
RestartSec=15
StateDirectory=streamclipper-os
Environment=PATH=/opt/streamclipper-os/.venv/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/streamclipper-os
# No --execute: private uploads require explicit admin change after validation.

[Install]
WantedBy=multi-user.target
